# Copy to .env (do NOT commit .env)
# ThingsBoard image tag (tb-node). Keep the whole team on the same version.
TB_VERSION=4.3.1.8
# PostgreSQL password (change if the stack is ever reachable from other machines)
POSTGRES_PASSWORD=postgres
# Tunnel token from Cloudflare Zero Trust > Networks > Tunnels
CLOUDFLARE_TUNNEL_TOKEN=
