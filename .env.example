# ==============================================================================
# SMART SAFE GUARDIAN - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env' and fill in your private credentials:
#   cp .env.example .env
#
# DO NOT commit '.env' to Git. Keep credentials private.

# ------------------------------------------------------------------------------
# 1. ThingsBoard Local Infrastructure (Docker & PostgreSQL - N07)
# ------------------------------------------------------------------------------
TB_VERSION=4.3.1.8
POSTGRES_PASSWORD=postgres

# Local / LAN ThingsBoard Addresses
THINGSBOARD_URL=http://localhost:8080
THINGSBOARD_HOST=auto
THINGSBOARD_MQTT_PORT=1883
THINGSBOARD_HTTP_PORT=8080

# ------------------------------------------------------------------------------
# 2. ThingsBoard Credentials & Device Access Token (T08, T11, N06, N07)
# ------------------------------------------------------------------------------
# System Administrator
SYSADMIN_USER=sysadmin@thingsboard.org
SYSADMIN_PASS=sysadmin

# Tenant Administrator
TENANT_TITLE="HCMUT Smart Safe"
TENANT_ADMIN_EMAIL=admin@smartsafeguardian.com
TENANT_ADMIN_PASS=tenant

# Vault Device & MQTT Access Token
DEVICE_NAME="Smart Safe Guardian"
THINGSBOARD_TOKEN=6EzRR6gcTvnOcgVF53hP

# Gateway Device Provisioning (Optional)
GATEWAY_NAME="Smart Safe Gateway"
GW_TOKEN=

# ------------------------------------------------------------------------------
# 3. Telegram Security Alert Bot (T13 - Third-Party Alert Integration)
# ------------------------------------------------------------------------------
# Bot token from @BotFather and destination chat/group ID (comma-separated for multiple admins)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 4. Hardware & Port Overrides (T06, T08)
# ------------------------------------------------------------------------------
# 'auto' enables intelligent USB device segregation (YoloUNO ESP32-S3 vs Badge CH340)
VAULT_PORT=auto
BADGE_PORT=auto
SERIAL_BAUDRATE=115200

# ------------------------------------------------------------------------------
# 5. Remote Tunnel (Optional - Cloudflare Zero Trust)
# ------------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=

# ------------------------------------------------------------------------------
# 6. CoreIOT Cloud Mirroring (Optional Dual-Platform Synchronization - T15)
# ------------------------------------------------------------------------------
# When configured, the Gateway simultaneously publishes all telemetry and audit logs
# to both local ThingsBoard and the university's CoreIOT cloud server.
COREIOT_HOST=app.coreiot.io
COREIOT_PORT=1883
COREIOT_TOKEN=
